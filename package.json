{
  "name": "agentcast",
  "version": "0.0.15",
  "description": "Live browser sessions for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./browser-agent": {
      "types": "./dist/browser-agent.d.ts",
      "import": "./dist/browser-agent.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./network-har": {
      "types": "./dist/network-har.d.ts",
      "import": "./dist/network-har.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./har-route": {
      "types": "./dist/har-route.d.ts",
      "import": "./dist/har-route.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "prepare": "tsc",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.0.0",
    "zod": "^4.4.3",
    "agents": "^0.1.6"
  },
  "peerDependenciesMeta": {
    "@cloudflare/containers": {
      "optional": true
    }
  },
  "keywords": [
    "browser",
    "automation",
    "ai",
    "agent",
    "cloudflare",
    "workers",
    "durable-objects",
    "containers"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/acoyfellow/agentcast"
  }
}
